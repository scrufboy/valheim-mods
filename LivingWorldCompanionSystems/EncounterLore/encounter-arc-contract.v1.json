    {"id":"village","selectionFact":"request_module_village_selected","target":"one bounded need belonging to a real nearby unresolved village record","resolutionFact":"splitash.request.village_resolved","repeatable":false,"allowedKinds":["supply","repair","escort","watch"],"forbiddenAssumptions":["raid","generated_village"]}
