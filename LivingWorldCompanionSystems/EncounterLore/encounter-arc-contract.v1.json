  "requestPresentationContract": {
    "owner": "future QuestBroker mechanics authority",
    "identityKey": "persisted_request_id",
    "defaultVisibility": "private_to_issuer_conversation",
    "privateNeedRule": "Runa or Edda personal needs stay with that speaker unless the issuer explicitly publicizes that specific persisted request",
