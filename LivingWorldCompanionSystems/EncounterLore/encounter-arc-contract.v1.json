  "lines": [
    {"id":"contact.friendly.banked_fire","speaker":"Friendly watcher","text":"Easy there. We saw you. The fire is ours, but the ground need not be.","intent":"greeting","voice":"hail","from":["mutual_notice"],"requires":["variant_friendly_banked_fire","speaker_owns_contact"],"sets":["speaking_distance_set"],"to":"contact_wary","cue":"open hand visible; partner keeps watch if present"},
    {"id":"contact.friendly.hunt","speaker":"Friendly watcher","text":"Hold the ridge. We are finishing this hunt, not starting another.","intent":"warning","voice":"warning","from":["mutual_notice"],"requires":["variant_friendly_hunting_pair","speaker_owns_contact"],"sets":["distance_boundary_stated"],"to":"contact_wary","cue":"turns side-on; bow remains lowered"},
    {"id":"contact.friendly.patrol","speaker":"Friendly lead","text":"You follow this road, or someone upon it?","intent":"asking","voice":"question","from":["mutual_notice"],"requires":["variant_friendly_road_patrol","speaker_owns_contact"],"sets":["player_purpose_questioned"],"to":"cautious_parley","cue":"stops outside weapon reach; partner covers rear"},
    {"id":"contact.friendly.injured","speaker":"Friendly survivor","text":"I can speak from here. Come no closer with steel out.","intent":"warning","voice":"warning","from":["mutual_notice"],"requires":["variant_friendly_injured_single"],"sets":["distance_boundary_stated"],"to":"contact_guarded","cue":"remains behind partial cover"},
    {"id":"contact.friendly.moving","speaker":"Friendly rear watcher","text":"You found us while leaving. Say what you need before the light goes.","intent":"asking","voice":"acknowledgment","from":["mutual_notice"],"requires":["variant_friendly_moving_camp","speaker_owns_contact"],"sets":["departure_context_known"],"to":"cautious_parley","cue":"marks player flank; packs remain shouldered"},
    {"id":"contact.pillager.false_rest","speaker":"Pillager","text":"Leave the pack and take the road. Test us, and you lose both.","intent":"threat","voice":"warning","from":["mutual_notice"],"requires":["variant_pillager_false_rest"],"sets":["pillager_demand_known"],"to":"hostile_contact","cue":"second Pillager holds exit angle"},
    {"id":"contact.pillager.toll","speaker":"Pillager","text":"This stretch costs food. Pay, turn, or make the price blood.","intent":"threat","voice":"challenge","from":["mutual_notice"],"requires":["variant_pillager_toll"],"sets":["pillager_demand_known"],"to":"hostile_contact","cue":"weapon visible; escape space remains"},
    {"id":"contact.pillager.wounded","speaker":"Pillager watcher","text":"You want our feud, or only the road?","intent":"asking","voice":"question","from":["mutual_notice"],"requires":["variant_pillager_wounded"],"sets":["bounded_bargain_available"],"to":"contact_guarded","cue":"watches player and tree line"},
    {"id":"contact.eitrherjar.notice","speaker":"Eitrherjar Legionary","text":"Another line to break.","intent":"challenge","voice":"challenge","from":["mutual_notice"],"requires":["variant_eitrherjar_lane"],"sets":["eitrherjar_hostility_revealed"],"to":"hostile_contact","cue":"squares body; weapon-ready purpose"},
    {"id":"contact.eitrherjar.advance","speaker":"Eitrherjar Legionary","text":"Hold your ground and be ended.","intent":"challenge","voice":"challenge","from":["hostile_contact"],"requires":["eitrherjar_combat_committed"],"sets":[],"to":"hostile_contact"},
    {"id":"contact.interrupt.friendly","speaker":"Friendly watcher","text":"Movement left—choose your side!","intent":"alarm","voice":"alarm","from":["third_party_interrupt"],"requires":["friendly_contact","third_party_threat_committed","alert_not_fired"],"sets":["alert_fired"],"to":"third_party_interrupt"},
    {"id":"contact.interrupt.pillager","speaker":"Pillager","text":"Beast first. Our matter waits.","intent":"temporary_truce","voice":"alarm","from":["third_party_interrupt"],"requires":["pillager_contact","third_party_threat_committed","temporary_nonaggression_declared","alert_not_fired"],"sets":["alert_fired"],"to":"third_party_interrupt"},
    {"id":"contact.after.friendly","speaker":"Friendly survivor","text":"You kept your word when noise made breaking it easy.","intent":"acknowledgment","voice":"acknowledgment","from":["third_party_interrupt"],"requires":["threat_verified_clear","player_honored_boundary_or_aid"],"sets":["earned_affinity"],"to":"cautious_parley"},
    {"id":"contact.after.pillager","speaker":"Pillager","text":"The beast is down. Now we finish our own business.","intent":"boundary","voice":"acknowledgment","from":["third_party_interrupt"],"requires":["threat_verified_clear","temporary_nonaggression_honored"],"sets":["pillager_pause_ended"],"to":"contact_guarded"},
    {"id":"contact.travel.offer","speaker":"Cautious survivor","text":"Our road runs with yours as far as the old stones. Walk it together?","intent":"asking","voice":"question","from":["cautious_parley"],"requires":["compatible_destination_known","safe_route_known","witnessed_need_or_aid","no_unresolved_harm"],"sets":["temporary_travel_terms_known"],"to":"temporary_travel"},
    {"id":"contact.travel.end","speaker":"Cautious survivor","text":"This is where we part. You made the road lighter.","intent":"acknowledgment","voice":"acknowledgment","from":["travel_endpoint"],"requires":["temporary_travel_completed","travel_terms_honored"],"sets":["earned_affinity"],"to":"disengaged"},
    {"id":"splitash.open.runa_warning","speaker":"Runa","text":"Weapon low, stranger. Ours will follow.","intent":"warning","voice":"warning","from":["contact_wary"],"requires":[],"sets":[],"to":"contact_wary"},
    {"id":"splitash.open.edda_warmth","speaker":"Edda","text":"If you came for warmth, leave room for sense.","intent":"warning","voice":null,"from":["contact_wary"],"requires":[],"sets":[],"to":"contact_wary"},
    {"id":"splitash.open.runa_names","speaker":"Runa","text":"Runa. That is Edda. We are between hearths.","intent":"identity","voice":null,"from":["contact_wary"],"requires":["weapon_lowered_after_warning"],"sets":["runa_name_known","edda_name_known","between_hearths_known"],"to":"camp_routine"},
    {"id":"splitash.open.edda_slow","speaker":"Edda","text":"And slower than we were yesterday.","intent":"plight","voice":null,"from":["camp_routine"],"requires":["edda_injured"],"sets":["edda_injury_known"],"to":"camp_routine"},
    {"id":"splitash.boundary.far_enough","speaker":"Runa","text":"That is far enough.","intent":"warning","voice":"warning","from":["contact_wary","contact_guarded"],"requires":["player_advanced_armed"],"sets":["boundary_warning_given"],"to":"contact_guarded"},
    {"id":"splitash.request.meal_offer","speaker":"Edda","text":"We have fire for one meal and food for half. Will you help even that?","intent":"asking","voice":"question","from":["camp_routine"],"requires":["request_module_meal_available","request_slot_empty"],"sets":["request_module_meal_selected"],"to":"request_offered","cue":"indicates pot; ordinary physical acting"},
    {"id":"splitash.request.boar_offer","speaker":"Runa","text":"Boar passed close. Hunt with me, and we both eat before dark.","intent":"asking","voice":"acknowledgment","from":["camp_routine"],"requires":["request_module_boar_available","request_slot_empty"],"sets":["request_module_boar_selected"],"to":"request_offered","cue":"points only if approved; otherwise turns toward verified tracks"},
    {"id":"splitash.request.threat_offer","speaker":"Runa","text":"Something nests too near the path. Clear it with us, or give it distance.","intent":"asking","voice":"warning","from":["camp_routine"],"requires":["request_module_threat_available","request_slot_empty"],"sets":["request_module_threat_selected"],"to":"request_offered","cue":"turns toward known approach"},
    {"id":"splitash.request.core_offer","speaker":"Edda","text":"A Surtling core would finish this. Only if your road has made such things lawful.","intent":"asking","voice":"question","from":["camp_routine"],"requires":["request_module_core_available","request_slot_empty"],"sets":["request_module_core_selected"],"to":"request_offered","cue":"shows incomplete fixture; no source asset implied"},
    {"id":"splitash.request.village_offer","speaker":"Runa","text":"That village asked for hands, not heroes. Will you help us answer?","intent":"asking","voice":"question","from":["camp_routine"],"requires":["request_module_village_available","request_slot_empty"],"sets":["request_module_village_selected"],"to":"request_offered","cue":"open hand toward verified route; emote only if approved"},
    {"id":"splitash.request.mapped_route_offer","speaker":"Runa","text":"You have walked that crossing. Show us the safe side, and we will remember the road.","intent":"asking","voice":"question","from":["camp_routine"],"requires":["request_module_mapped_route_available","request_slot_empty","player_explicitly_shared_eligible_map_knowledge"],"sets":["request_module_mapped_route_selected","request_presenter_camp"],"to":"request_offered","cue":"looks from offered map to trail; no map-reading emote asserted"},
    {"id":"splitash.request.player_accept","speaker":"Player","text":"I will help.","intent":"accepting","voice":null,"from":["request_offered"],"requires":["one_request_module_selected"],"sets":["active_request_accepted"],"to":"request_active"},
    {"id":"splitash.request.runa_accept","speaker":"Runa","text":"Good. We do it together.","intent":"acknowledgment","voice":"acknowledgment","from":["request_active"],"requires":["active_request_accepted"],"sets":[],"to":"request_active","cue":"turns back to work"},
    {"id":"splitash.request.player_decline","speaker":"Player","text":"No. Not now.","intent":"refusing","voice":null,"from":["request_offered"],"requires":["one_request_module_selected"],"sets":["small_request_declined"],"to":"camp_routine"},
    {"id":"splitash.request.edda_decline","speaker":"Edda","text":"Fair enough. The need remains ours.","intent":"acknowledgment","voice":"acknowledgment","from":["camp_routine"],"requires":["small_request_declined"],"sets":["request_slot_closed_for_resolution"],"to":"camp_routine","cue":"small head shake; shrug only after approval"},
    {"id":"splitash.request.runa_complete","speaker":"Runa","text":"You saw the work and put a hand to it.","intent":"acknowledgment","voice":"acknowledgment","from":["request_resolved"],"requires":["splitash.earned_respect"],"sets":["earned_respect_acknowledged"],"to":"request_resolved","cue":"weapon stowed"},
    {"id":"splitash.request.edda_complete","speaker":"Edda","text":"That is better than a speech.","intent":"acknowledgment","voice":"relief","from":["request_resolved"],"requires":["earned_respect_acknowledged"],"sets":["request_resolution_closed"],"to":"camp_routine"},
    {"id":"splitash.shock.edda_down","speaker":"Runa","text":"Edda—down!","intent":"alarm","voice":"alarm","from":["shock_active"],"requires":["edda_ankle_folded"],"sets":[],"to":"shock_active"},
    {"id":"splitash.shock.left_side","speaker":"Runa","text":"Left side! Do not let them through!","intent":"asking","voice":null,"from":["shock_active"],"requires":["player_local","blind_side_attack_active"],"sets":["aid_requested"],"to":"shock_active"},
    {"id":"splitash.aid.runa_relief","speaker":"Runa","text":"You held the open side. Edda still breathes.","intent":"acknowledgment","voice":"relief","from":["shared_defense"],"requires":["player_held_shared_defense","edda_alive","threat_clear"],"sets":["shared_defense_acknowledged"],"to":"safe_fallback"},
    {"id":"splitash.aid.edda_supper","speaker":"Edda","text":"The supper does not. I will mourn it properly.","intent":"humor","voice":null,"from":["safe_fallback"],"requires":["camp_meal_lost","edda_alive"],"sets":[],"to":"safe_fallback"},
    {"id":"splitash.aid.runa_brace","speaker":"Runa","text":"Help me brace the ankle. Then we speak.","intent":"asking","voice":null,"from":["safe_fallback"],"requires":["edda_alive","threat_clear"],"sets":["care_interaction_available"],"to":"safe_fallback"},
    {"id":"splitash.refuse.runa","speaker":"Runa","text":"Go, then. I will not spend breath begging twice.","intent":"refusing","voice":"acknowledgment","from":["camp_routine","shock_active"],"requires":["player_refused_aid"],"sets":["aid_refusal_remembered"],"to":"aid_refused"},
    {"id":"splitash.retreat.call","speaker":"Runa","text":"To the stones. Together!","intent":"command","voice":"alarm","from":["shock_active"],"requires":["camp_overrun_or_runa_retreat_threshold"],"sets":["retreat_called"],"to":"retreating"},
    {"id":"splitash.violation.runa","speaker":"Runa","text":"We offered distance. You answered with taking.","intent":"warning","voice":"warning","from":["contact_guarded","camp_routine","safe_fallback"],"requires":["player_harm_unresolved"],"sets":["recruitment_blocked_by_harm"],"to":"harm_unresolved"},
    {"id":"splitash.talk.runa_origin","speaker":"Runa","text":"I woke under a sky I knew, in a land I did not. The raven wanted a weapon. Edda needed a road.","intent":"origin_belief","voice":null,"from":["fire_talk"],"requires":["shared_defense_or_covered_retreat"],"sets":["runa_second_breath_belief_known","runa_choice_known"],"to":"fire_talk"},
    {"id":"splitash.talk.edda_choice","speaker":"Edda","text":"She chose the road. That is the useful part of the tale.","intent":"belief","voice":null,"from":["fire_talk"],"requires":["edda_alive","runa_choice_known"],"sets":[],"to":"fire_talk"},
    {"id":"splitash.talk.runa_home","speaker":"Runa","text":"I will not leave Edda in open country. Show me a defended bed for them, and I can range farther than this fire.","intent":"boundary","voice":null,"from":["fire_talk"],"requires":["edda_alive"],"sets":["edda_home_requirement_known"],"to":"invitation_ready"},
    {"id":"invitation.player.exact","speaker":"Player","text":"Will you come with me?","intent":"invitation","voice":null,"from":["invitation_ready"],"requires":["no_invitation_path_committed"],"sets":["invitation_path_player","invitation_asked"],"to":"invitation_ready"},
    {"id":"splitash.answer.yes","speaker":"Runa","text":"Yes. Edda has a hearth, and you held when leaving was easier. I will come.","intent":"accepting","voice":"assent","from":["invitation_ready"],"requires":["invitation_path_player","qualifying_encounter_aid","edda_alive","edda_valid_home_bed","open_bonded_roster_seat","recruitment_world_gate_met","no_unresolved_harm"],"sets":["runa_bonded"],"to":"bonded_homebound"},
    {"id":"splitash.invitation.npc","speaker":"Runa","text":"Edda is safe. Your road is one I would choose. Will you have me?","intent":"invitation","voice":"question","from":["invitation_ready"],"requires":["no_invitation_path_committed","sufficient_witnessed_aid","edda_alive","edda_valid_home_bed","open_bonded_roster_seat","recruitment_world_gate_met","no_unresolved_harm"],"sets":["invitation_path_npc","npc_invitation_asked"],"to":"npc_invitation_ready","cue":"weapon stowed"},
    {"id":"splitash.invitation.player_yes","speaker":"Player","text":"Yes. Come with me.","intent":"accepting","voice":null,"from":["npc_invitation_ready"],"requires":["invitation_path_npc"],"sets":["player_accepted_npc_invitation"],"to":"npc_invitation_ready"},
    {"id":"splitash.invitation.runa_assent","speaker":"Runa","text":"Then yes. My road and yours run together.","intent":"accepting","voice":"assent","from":["npc_invitation_ready"],"requires":["player_accepted_npc_invitation"],"sets":["runa_bonded"],"to":"bonded_homebound"},
    {"id":"splitash.invitation.player_no","speaker":"Player","text":"No. Not now.","intent":"refusing","voice":null,"from":["npc_invitation_ready"],"requires":["invitation_path_npc"],"sets":["player_declined_npc_invitation"],"to":"npc_invitation_ready"},
    {"id":"splitash.invitation.runa_no_ack","speaker":"Runa","text":"Then we part as friends.","intent":"acknowledgment","voice":"acknowledgment","from":["npc_invitation_ready"],"requires":["player_declined_npc_invitation"],"sets":["recruitment_refused_without_hostility"],"to":"fire_talk"},
    {"id":"splitash.answer.no_home","speaker":"Runa","text":"No. Not while Edda's only roof is smoke. Make a home, then ask again.","intent":"refusing","voice":"refusal","from":["invitation_ready"],"requires":["edda_alive","edda_valid_home_bed_false"],"sets":["refusal_reason_no_home"],"to":"fire_talk"},
    {"id":"splitash.answer.no_roster","speaker":"Runa","text":"No. Your promises already fill your hall. Keep them before you make another.","intent":"refusing","voice":"refusal","from":["invitation_ready"],"requires":["open_bonded_roster_seat_false"],"sets":["refusal_reason_roster_full"],"to":"fire_talk"},
    {"id":"splitash.answer.no_gate","speaker":"Runa","text":"No. You have a road yet to prove. We can still share this fire.","intent":"refusing","voice":"refusal","from":["invitation_ready"],"requires":["recruitment_world_gate_met_false"],"sets":["refusal_reason_world_gate"],"to":"fire_talk"},
    {"id":"splitash.answer.no_refusal","speaker":"Runa","text":"No. When the line broke, you chose your road. I remember it.","intent":"refusing","voice":"refusal","from":["invitation_ready"],"requires":["player_refused_aid","no_later_qualifying_deed"],"sets":["refusal_reason_prior_choice"],"to":"fire_talk"},
    {"id":"splitash.answer.no_harm","speaker":"Runa","text":"No. Strength without restraint is only another danger.","intent":"refusing","voice":"refusal","from":["invitation_ready","harm_unresolved"],"requires":["player_harm_unresolved"],"sets":["refusal_reason_harm"],"to":"harm_unresolved"},
    {"id":"splitash.release.runa_question","speaker":"Runa","text":"You mean this watch, not the end of our road?","intent":"asking","voice":"question","from":["release_pending"],"requires":["safe_handoff_selected","loaned_items_resolved"],"sets":["release_meaning_checked"],"to":"release_pending"},
    {"id":"splitash.release.player_confirm","speaker":"Player","text":"Stay here. Keep this place.","intent":"confirming","voice":null,"from":["release_pending"],"requires":["release_meaning_checked"],"sets":["release_confirmed"],"to":"release_pending"},
    {"id":"splitash.release.runa_home","speaker":"Runa","text":"Then I come home standing. I will keep the outer path.","intent":"accepting","voice":"assent","from":["release_pending"],"requires":["release_confirmed","safe_handoff_selected","loaned_items_resolved"],"sets":["runa_resident_guard"],"to":"resident_home"},
    {"id":"splitash.release.edda_quiet","speaker":"Edda","text":"Good. The roof has been unbearably quiet.","intent":"homecoming","voice":null,"from":["resident_home"],"requires":["edda_present"],"sets":[],"to":"resident_home"},
    {"id":"splitash.release.runa_leak","speaker":"Runa","text":"You complained when it leaked.","intent":"humor","voice":"laugh","from":["resident_home"],"requires":["edda_present"],"sets":[],"to":"resident_home"},
    {"id":"splitash.release.edda_multitudes","speaker":"Edda","text":"I contain multitudes.","intent":"humor","voice":null,"from":["resident_home"],"requires":["edda_present"],"sets":[],"to":"reunion_ready"},
    {"id":"splitash.release.runa_word","speaker":"Runa","text":"Then send word to Edda. I have a roof to report.","intent":"homecoming","voice":"assent","from":["resident_home"],"requires":["edda_safe_elsewhere"],"sets":[],"to":"reunion_ready"},
    {"id":"splitash.release.no_home","speaker":"Runa","text":"Not here. Find us a fire that will still be burning tomorrow.","intent":"refusing","voice":"refusal","from":["release_pending"],"requires":["safe_handoff_selected_false"],"sets":["release_blocked_no_home"],"to":"active_party"},
    {"id":"splitash.reunion.runa","speaker":"Runa","text":"The path is clear. Are we ranging again?","intent":"reunion","voice":"question","from":["reunion_ready"],"requires":["runa_resident_guard","player_returned"],"sets":["rejoin_offer_available"],"to":"reunion_ready"},
    {"id":"plains.shock.ketil","speaker":"Yrsa","text":"Ketil! Wall side!","intent":"alarm","voice":"alarm","from":["shock_active"],"requires":["ketil_displaced"],"sets":[],"to":"shock_active"},
    {"id":"plains.shock.lane","speaker":"Yrsa","text":"Draw them past the stones; give me a lane!","intent":"asking","voice":null,"from":["shock_active"],"requires":["player_local","plains_shock_started"],"sets":["lane_aid_requested"],"to":"shock_active"},
    {"id":"plains.after.yrsa","speaker":"Yrsa","text":"You made the opening. We spent it well.","intent":"acknowledgment","voice":"relief","from":["shared_defense"],"requires":["player_created_throwing_lane","threat_clear"],"sets":["plains_shared_defense_acknowledged"],"to":"safe_fallback"},
    {"id":"plains.after.ketil","speaker":"Ketil","text":"And I spent a wall.","intent":"humor","voice":null,"from":["safe_fallback"],"requires":["ketil_alive","wall_damaged"],"sets":[],"to":"safe_fallback"},
    {"id":"plains.after.duty","speaker":"Yrsa","text":"Fulings return by this track. We leave when the wounded and stores are clear—not before.","intent":"boundary","voice":null,"from":["safe_fallback"],"requires":["fuling_route_known"],"sets":["ketil_duty_known"],"to":"invitation_ready"},
    {"id":"plains.answer.yes","speaker":"Yrsa","text":"Yes. Ketil has a wall, and you know how to make a lane.","intent":"accepting","voice":"assent","from":["invitation_ready"],"requires":["ketil_duty_resolved","plains_recruitment_gate_met","valid_home_bed","open_bonded_roster_seat","no_unresolved_harm"],"sets":["yrsa_bonded"],"to":"bonded_homebound"},
    {"id":"plains.answer.no_duty","speaker":"Yrsa","text":"No. A hunter who abandons her wall soon hunts alone.","intent":"refusing","voice":"refusal","from":["invitation_ready"],"requires":["ketil_duty_resolved_false"],"sets":["refusal_reason_duty"],"to":"safe_fallback"},
    {"id":"plains.release.home","speaker":"Yrsa","text":"This field has room to throw and a door worth returning through. I will take the watch.","intent":"homecoming","voice":"assent","from":["release_pending"],"requires":["safe_farm_watch","loaned_items_resolved"],"sets":["yrsa_resident_guard"],"to":"resident_home"},
    {"id":"plains.reunion.yrsa","speaker":"Yrsa","text":"The east track is quiet. Shall we change that?","intent":"reunion","voice":"question","from":["reunion_ready"],"requires":["yrsa_resident_guard","player_returned"],"sets":["rejoin_offer_available"],"to":"reunion_ready"}
  ]
}
